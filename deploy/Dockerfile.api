ARG MAVEN_IMAGE=docker.m.daocloud.io/library/maven:3.9-eclipse-temurin-17
ARG JRE_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:17-jre
FROM ${MAVEN_IMAGE} AS build
WORKDIR /src
COPY cti-server /src
RUN mkdir -p /root/.m2 && printf '%s\n' \
    '<settings><mirrors><mirror><id>aliyun</id><mirrorOf>*</mirrorOf><url>https://maven.aliyun.com/repository/public</url></mirror></mirrors></settings>' \
    > /root/.m2/settings.xml \
    && mvn -pl cti-api -am package -DskipTests

FROM ${JRE_IMAGE}
WORKDIR /opt/cti
COPY --from=build /src/cti-api/target/cti-api-1.0.0-SNAPSHOT.jar /opt/cti/app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "/opt/cti/app.jar"]
