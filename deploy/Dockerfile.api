FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY cti-server /src
RUN mvn -pl cti-api -am package -DskipTests

FROM eclipse-temurin:17-jre
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/cti
COPY --from=build /src/cti-api/target/cti-api-1.0.0-SNAPSHOT.jar /opt/cti/app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "/opt/cti/app.jar"]
